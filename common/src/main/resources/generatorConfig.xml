<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE generatorConfiguration
  PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN"
  "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd" >
<generatorConfiguration>
  <context id="context1" targetRuntime="MyBatis3">
    <property name="javaFileEncoding" value="UTF-8"/>

    <plugin type="org.mybatis.generator.plugins.RowBoundsPlugin"/>
    <plugin type="org.mybatis.generator.plugins.SerializablePlugin"/>
    <plugin type="org.mybatis.generator.plugins.FluentBuilderMethodsPlugin"/>
    <plugin type="org.mybatis.generator.plugins.MapperAnnotationPlugin"/>

    <!-- コメント生成の抑制 -->
    <commentGenerator>
      <property name="suppressDate" value="true"/>
      <property name="addRemarkComments" value="false"/>
    </commentGenerator>

    <!-- JDBCの設定 -->
    <jdbcConnection
      driverClass="com.mysql.cj.jdbc.Driver"
      connectionURL="${mysql.url}"
      userId="${mysql.user}"
      password="${mysql.password}"
    />

    <javaTypeResolver>
      <property name="useJSR310Types" value="true"/>
    </javaTypeResolver>

    <!-- Entityの生成場所 -->
    <modelGenerator
      targetPackage="org.ymmy.todo_chat.db.entity"
      targetProject="${mybatis-generator.java-target}"
    >
      <property name="constructorBased" value="true"/>
    </modelGenerator>
    <!-- Mapper(xml)の生成場所 -->
    <sqlMapGenerator
      targetPackage="db.mapper"
      targetProject="${mybatis-generator.resources-target}"
    />
    <!-- Mapper(java)の生成場所 -->
    <clientGenerator
      targetPackage="org.ymmy.todo_chat.db.mapper"
      targetProject="${mybatis-generator.java-target}"
      type="XMLMAPPER"
    />

    <!-- 生成対象のテーブル -->
    <table tableName="authority" modelType="flat">
      <generatedKey column="id" sqlStatement="MySql" identity="true"/>
    </table>
  </context>
</generatorConfiguration>
